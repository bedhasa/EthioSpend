<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#FFFFFF"
    android:gravity="center"
    android:padding="32dp">

    <!-- Title -->
    <TextView
        android:id="@+id/tvTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/enter_pin"
        android:textSize="24sp"
        android:textColor="#008000"
        android:textStyle="bold"
        android:layout_marginBottom="24dp"/>

    <!-- PIN Circles -->
    <LinearLayout
        android:id="@+id/pinDots"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="16dp">

        <View android:id="@+id/dot1" style="@style/pinDot"/>
        <View android:id="@+id/dot2" style="@style/pinDot"/>
        <View android:id="@+id/dot3" style="@style/pinDot"/>
        <View android:id="@+id/dot4" style="@style/pinDot"/>
    </LinearLayout>

    <!-- Forgot PIN -->
    <TextView
        android:id="@+id/tvForgot"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/forgot_pin"
        android:textColor="#008000"
        android:textSize="14sp"
        android:layout_marginBottom="32dp"/>

    <!-- Hidden PIN input for logic -->
    <EditText
        android:id="@+id/pinInput"
        android:layout_width="1dp"
        android:layout_height="1dp"
        android:inputType="numberPassword"
        android:maxLength="4"
        android:focusable="true"
        android:background="@android:color/transparent"
        android:importantForAutofill="no" />

    <!-- Number Pad -->
    <GridLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:columnCount="3"
        android:rowCount="4">

        <!-- Row 1 -->
        <Button style="@style/numBtn" android:id="@+id/btn1" android:text="1"/>
        <Button style="@style/numBtn" android:id="@+id/btn2" android:text="2"/>
        <Button style="@style/numBtn" android:id="@+id/btn3" android:text="3"/>

        <!-- Row 2 -->
        <Button style="@style/numBtn" android:id="@+id/btn4" android:text="4"/>
        <Button style="@style/numBtn" android:id="@+id/btn5" android:text="5"/>
        <Button style="@style/numBtn" android:id="@+id/btn6" android:text="6"/>

        <!-- Row 3 -->
        <Button style="@style/numBtn" android:id="@+id/btn7" android:text="7"/>
        <Button style="@style/numBtn" android:id="@+id/btn8" android:text="8"/>
        <Button style="@style/numBtn" android:id="@+id/btn9" android:text="9"/>

        <!-- Row 4 -->
        <View android:layout_width="70dp" android:layout_height="70dp"/>
        <Button style="@style/numBtn" android:id="@+id/btn0" android:text="0"/>
        <Button style="@style/numBtn" android:text="⌫" android:id="@+id/btnDelete"/>
    </GridLayout>
</LinearLayout>
